{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('gmUid').val() === auth.uid) || data.child('gmUid').val() === auth.uid)"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($room).child('meta').child('gmUid').val() === auth.uid)"
          }
        },
        "scene": {
          ".write": "auth != null && root.child('rooms').child($room).child('meta').child('gmUid').val() === auth.uid"
        },
        "actions": {
          "$action": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid || root.child('rooms').child($room).child('meta').child('gmUid').val() === auth.uid)"
          }
        },
        "history": {
          "$entry": {
            ".write": "auth != null"
          }
        },
        "updatedAt": {
          ".write": "auth != null"
        }
      }
    },
    "private": {
      "$room": {
        "gm": {
          ".read": "auth != null && root.child('rooms').child($room).child('meta').child('gmUid').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($room).child('meta').child('gmUid').val() === auth.uid"
        },
        "users": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($room).child('meta').child('gmUid').val() === auth.uid)",
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($room).child('meta').child('gmUid').val() === auth.uid)"
          }
        }
      }
    }
  }
}